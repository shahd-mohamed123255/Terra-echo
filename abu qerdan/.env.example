# Copy this file to .env and configure only the integrations you plan to use.
TERRA_ECHO_DATA_DIR=./data
TERRA_ECHO_DATABASE_PATH=./data/terra_echo.sqlite3
TERRA_ECHO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TERRA_ECHO_HOST=0.0.0.0
TERRA_ECHO_PORT=8000
# Set the same private value as AGENT_API_TOKEN in the Laravel app.
TERRA_ECHO_API_TOKEN=
TERRA_ECHO_REQUIRE_API_TOKEN=true

# Optional OpenAI-compatible provider. Leave unset for the clearly labeled fallback assistant.
TERRA_ECHO_LLM_API_KEY=
TERRA_ECHO_LLM_BASE_URL=https://api.openai.com/v1
TERRA_ECHO_LLM_MODEL=gpt-4o-mini
TERRA_ECHO_LLM_TIMEOUT_SECONDS=30

# NASA POWER is a public endpoint; no key is required.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIMEOUT_SECONDS=20

# Optional search endpoint must accept ?q=<query>&limit=<n> and return {"results":[{"title","url","snippet","source","date"}]}.
TERRA_ECHO_SEARCH_URL=
TERRA_ECHO_SEARCH_API_KEY=
